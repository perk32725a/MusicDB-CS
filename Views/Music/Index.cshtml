@model IEnumerable<MusicDatabase.Models.Music>

@{
    ViewData["Title"] = "Views/Music/Index.cshtml";
}

<h2>@ViewData["Title"]</h2>

@* goes to Views/Music/Create.cshtml *@
<p>
    <a asp-action="Create">Add New | </a>
    <a asp-action="Refresh">Refresh</a>
</p>

@* added so we can search *@
<form asp-controller="Music" asp-action="Index" method="get">
    <p>
        Search: <input type="text" name="SearchString" />&nbsp;
        In Album:  <input type="radio" name="SearchFor" value="Album" />&nbsp;
        or Artist: <input type="radio" name="SearchFor" value="Artist" />&nbsp;
        or Both:   <input type="radio" name="SearchFor" value="Both" checked />&nbsp;
        <input type="submit" value="Search Me" />
    </p>
</form>
@*
    NEED TO MAKE THE INDEX.CSHTML IN VIEWS/SONGS LOOK LIKE THIS ONE,
    BUT USE VIEWDATA[] TO PASS ALBUM/ARTIST/RELEASE DATA
*@
<table class="table">
    <thead>
        @* table headers *@

        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Artist)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Album)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ReleaseDate)
            </th>
            <th></th>
        </tr>

    </thead>

    <tbody>
        @* the table *@
        @foreach (var item in Model.OrderBy(model => model.Artist)) // order the list by artist
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Artist)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Album)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.ReleaseDate)
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.ID">Edit</a> |     @* goes to Views/Music/Edit.cshtml    *@
                    <a asp-action="Details" asp-route-id="@item.ID">Details</a> |  @* goes to Views/Music/Details.cshtml *@
                    <a asp-action="Delete" asp-route-id="@item.ID">Delete</a>     @* goes to Views/Music/Delete.cshtml  *@
                </td>
            </tr>
        }

    </tbody>

    <tbody>
        @* the songs table *@
        @*
        @foreach (var item in Model.OrderBy(song => song.SongTitle))
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.SongTitle)
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.ID">Edit</a> |     @* goes to Views/Music/Edit.cshtml    *@
        @*            <a asp-action="Details" asp-route-id="@item.ID">Details</a> |  @* goes to Views/Music/Details.cshtml *@
        @*            <a asp-action="Delete" asp-route-id="@item.ID">Delete</a>     @* goes to Views/Music/Delete.cshtml  *@
        @*
                </td>
            </tr>
        }
        *@
        
    </tbody>
</table>
